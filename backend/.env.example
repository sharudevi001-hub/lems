# Copy to .env locally; set actual values in Railway Variables for production.
# Do not commit .env.
NODE_ENV=development
PORT=3000
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=lems_app
MYSQLPASSWORD=replace-with-a-local-secret
MYSQLDATABASE=lems_db
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:3000
EMAIL_USER=
EMAIL_PASS=
# Optional: set a long random key before enabling ESP32/kiosk API calls.
KIOSK_API_KEY=
